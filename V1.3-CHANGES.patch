+const root=path.resolve(import.meta.dirname,'../export/web'),plan=JSON.parse(fs.readFileSync(path.join(root,'theater-daylight.json')));
+test('generated daylight plan is deterministic, bounded and retains native-source identity',()=>{assert.deepEqual(buildDaylightPlan(root),plan);assert(plan.shafts.length>=6&&plan.shafts.length<=10);for(const room of ['Lobby','Theater','Upper hall / VIP','Speed Cola room'])assert(plan.shafts.some(s=>s.room===room));assert(!plan.shafts.some(s=>/Dressing/.test(s.room)));assert.match(plan.provenance.worldSha256,/^[a-f0-9]{64}$/);for(const s of plan.shafts){assert(s.radius>0&&s.radius<=12);assert(s.length>=110&&s.length<=1400);assert(s.transmission>0&&s.transmission<=1);assert.equal(s.probes.count,17);}});
+test('every packaged shaft circumference clears actual native sunward geometry and stops before an opaque receiver',()=>{const optical=createDaylightGeometry(root),direction=new THREE.Vector3(...plan.sunDirection).normalize(),down=direction.clone().negate();for(const shaft of plan.shafts){const start=new THREE.Vector3(...shaft.start),end=new THREE.Vector3(...shaft.end),length=start.distanceTo(end);assert(end.clone().sub(start).normalize().dot(down)>.999999);for(const offset of shaftCrossSection(direction,shaft.radius)){const p=start.clone().add(offset),sunRay=new THREE.Ray(p,direction);assert(optical.transmission(sunRay)>0,shaft.id+' sky');const hit=firstOpaqueHit(optical,new THREE.Ray(p,down));assert(hit&&hit.distance-length>5.8,shaft.id+' clipped before solid surface');}}});
