+import * as THREE from 'three';
+
+// A small pool uses authored fixture positions. The original T5 lightmaps are
+// unavailable; these practical accents are a deliberate reconstruction.
+export class TheaterLighting{
+  constructor(scene,data){
+    this.sources=data.entities.filter(e=>e.classname==='light'&&e.position).map(e=>{
+      let rgb=(e.script_light2_color||e._color||'1 .78 .53').split(/\s+/).map(Number);
+      if(rgb.length!==3||rgb.some(n=>!Number.isFinite(n))||rgb.every(n=>n===0))rgb=[1,.78,.53];
+      return {position:new THREE.Vector3(...e.position),color:new THREE.Color(...rgb),radius:Math.max(300,Math.min(1000,Number(e.radius)||500))};
+    });
+    this.pool=Array.from({length:4},()=>{const light=new THREE.PointLight(0xffca82,0,700,1);scene.add(light);return light;});
+    this.nextUpdate=0;
+  }
+  update(position,power,time){
+    if(time<this.nextUpdate)return;this.nextUpdate=time+.4;
+    const sources=this.sources.map(source=>({source,distance:source.position.distanceToSquared(position)})).sort((a,b)=>a.distance-b.distance).slice(0,this.pool.length);
+    for(let i=0;i<this.pool.length;i++){const light=this.pool[i],entry=sources[i];if(!entry){light.intensity=0;continue;}light.position.copy(entry.source.position);light.color.copy(entry.source.color);light.distance=entry.source.radius;light.intensity=(power?210:45)*Math.max(0,1-Math.sqrt(entry.distance)/1600);}
+  }
+  reset(){this.nextUpdate=0;for(const light of this.pool)light.intensity=0;}
+}
