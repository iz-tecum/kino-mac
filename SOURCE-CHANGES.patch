+  const root = new THREE.Group(), parent = new THREE.Group();
+  root.position.set(37, 14, 83); root.rotation.set(.2, -.3, .1); root.scale.set(1.2, .7, 1.8);
+  parent.position.set(100, 20, 100); parent.rotation.y = .2;
+  root.add(parent);
