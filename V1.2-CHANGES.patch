+  const color=(e.script_light2_color||e._color||'1 .8 .6').trim().split(/\s+/).map(Number);
+  if(color.every(n=>n===0))continue;
+  const ceiling=/^tl/.test(event), powered=ceiling||event==='ZPO'||e.targetname==='light_off';
